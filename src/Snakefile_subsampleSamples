#############################
# DIRECTORIES AND VARIABLES #
#############################

threadsMax = 16

ROOT_DIR  = config["par_general"]["outdir"]
OUTPUT_DIR = ROOT_DIR + "/output/FINAL_OUTPUT/extension100/subsamplingSamples"

repetitionsMax = 50
replicatesNo = range(1, repetitionsMax + 1)

#########
# RULES #
#########

localrules: all

rule all:
    input:
        stats = expand('{dir}/CLL.subsample{nSamplesRare}_{replicate}.StatsAllTF.tsv', dir = OUTPUT_DIR, nSamplesRare = [3, 4, 5, 6, 7, 8, 9, 10, 15, 20, 25, 30], replicate = replicatesNo),
        stats2 = expand('{dir}/CLL.subsample{nSamplesRare}_{replicate}.StatsAllTF.tsv', dir = OUTPUT_DIR, nSamplesRare = [34], replicate = 1)

rule runSubsample:
    output:
        stats    = expand('{dir}/CLL.subsample{{nSamplesRare}}_{{replicate}}.StatsAllTF.tsv', dir = OUTPUT_DIR)
    message: "{ruleDisplayMessage}Run R script for {wildcards.nSamplesRare}_{wildcards.replicate}"
    threads: 1
    params:
        scriptName    = "/g/scb2/zaugg/carnold/Projects/PWM_Ivan/src/R/subsample.R",
        rootFolder    = ROOT_DIR,
        outputFolder  = OUTPUT_DIR,
        subsampleName = lambda wildcards: str(wildcards.nSamplesRare) + "_" + str(wildcards.replicate),
        repetitionsMax= repetitionsMax
    shell:
        """sh -c '
            Rscript {params.scriptName:q} \
                {params.rootFolder:q} \
                {params.outputFolder:q} \
                {params.subsampleName} \
                {params.repetitionsMax}
        '"""
