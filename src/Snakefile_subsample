localrules: all

rule all:
    input:
        bam = expand('{dir}/{sample}.downsample{fraction}.bam', dir = OUTPUT_DIR, sample = allBamFilesBasename, fraction = ["0.75","0.50","0.25","0.125", "0.06", "0.02", "0.01", "0.001"])

def generateRandomNumber(wildcards):
    """text"""
    seed = random.seed()
    return random.randrange(1,100000000)

rule Picard_subsampleBAM:
    input:
        bam = expand('{dir}/{{sample}}.bam', dir = INPUT_DIR)
    output:
        bam   = expand('{dir}/{{sample}}.downsample{{fraction}}.bam', dir = OUTPUT_DIR),
        index = expand('{dir}/{{sample}}.downsample{{fraction}}.bai', dir = OUTPUT_DIR)
    log: LOG_BENCHMARK_DIR + "/Picard_subsampleBAM.{sample}.{fraction}.log"
    message:
        "{ruleDisplayMessage}Subsample {input:q} to produce file {output.bam:q} ..."
    threads: 1
    conda: "/g/scb2/zaugg/zaugg_shared/Programs/Snakemake/environmentsYAML/picard_samtools.yaml"
    params:
        randomNumber = lambda wildcards: generateRandomNumber(wildcards)
    shell:
            """{picard_command} DownsampleSam \
            I={input.bam:q} \
            O={output.bam:q} \
            CREATE_INDEX=true \
            RANDOM_SEED={params.randomNumber} \
            PROBABILITY={wildcards.fraction} \
            2> {log:q}"""
